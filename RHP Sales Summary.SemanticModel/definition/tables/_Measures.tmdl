	measure MoM = ```
			
			IF(ISFILTERED('Date'[Month]) || ISFILTERED('Date'[DateMoM]),
			    FORMAT([Total Sales] - [Previous Month Sales], 
			            "$#,#00;(-$#,#00)"),
			    BLANK()
			)
			```
		displayFolder: MoM
		lineageTag: 2c8dcc4b-b005-4e8c-94c1-8acc668503ac

	measure 'Previous Month Sales' =
			
			IF(ISFILTERED('Date'[Month]) || ISFILTERED('Date'[DateMoM]),
			            CALCULATE([Total Sales]
			                    ,PREVIOUSMONTH('Date'[Date])
			                    ),
			            BLANK()
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: MoM
		lineageTag: ed9cc2d8-bf67-4c73-921f-2c5cc1155383

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% Previous Month' = ```
			VAR _prev =  DIVIDE([Total Sales] - [Previous Month Sales], [Previous Month Sales])
			                RETURN
			                    IF (NOT (ISBLANK([Previous Month Sales])),
			                        IF(_prev > 0, 
			                            "⬆️ " & FORMAT(_prev, "#.00%;(-#.00%)") ,
			                            "⬇️ " & FORMAT(_prev, "#.00%;(-#.00%)")
			                        )
			                    )
			```
		displayFolder: MoM
		lineageTag: a92e949a-3eb0-4ed3-959f-d1de07368d70

	measure 'Previous Month Color' = ```
			VAR _prev =  DIVIDE([Total Sales] - [Previous Month Sales], [Previous Month Sales])
